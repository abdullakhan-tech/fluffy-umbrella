# Local-only bind by default. Use a private network + HTTPS reverse proxy for remote access.
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# Firebase Admin verifies Firebase ID tokens and App Check tokens.
FIREBASE_PROJECT_ID=your-firebase-project-id
APP_CHECK_REQUIRED=true

# Comma-separated exact browser origins; wildcard origins are ignored.
CORS_ORIGINS=

# Single-process defense-in-depth limits (not shared between workers/instances).
RATE_LIMIT_USER_PER_MINUTE=60
RATE_LIMIT_IP_PER_MINUTE=120
MAX_REQUEST_BODY_BYTES=262144

# Server-side provider credentials only. Never place these in Android source.
OPENAI_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_AI_PROVIDER=fallback

# Firebase Admin credentials are supplied through Application Default Credentials.
# For local service-account development, export GOOGLE_APPLICATION_CREDENTIALS
# to a file outside this repository. Production should use workload identity.
