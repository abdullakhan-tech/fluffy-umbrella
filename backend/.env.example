PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
CORS_ORIGINS=*

# Server-side AI Provider Keys (Never commit actual keys)
# External AI provider calls stay strictly on the server-side
OPENAI_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_AI_PROVIDER=fallback

# Optional Stonic gateway (only if it supports OpenAI-compatible /v1/chat/completions)
STONIC_BASE_URL=
STONIC_API_KEY=
STONIC_MODEL=stonic-default
