PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
CORS_ORIGINS=*

# Server-side AI Provider Keys (Never commit actual keys)
# External AI provider calls stay strictly on the server-side
OPENAI_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_AI_PROVIDER=fallback

# Bounded retries for transient OpenAI, Gemini and Ollama transport/provider failures.
# Attempts include the initial request; 2 means at most one retry.
PROVIDER_MAX_ATTEMPTS=2
PROVIDER_RETRY_BASE_SECONDS=0.25
PROVIDER_RETRY_MAX_SECONDS=2.0
