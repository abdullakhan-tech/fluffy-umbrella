OFFICE_KEY=change-me-to-a-long-random-string
PORT=8787
ALLOW_ORIGIN=https://zaytharai.com

# Zaythar AI Engine (Gemini / Google AI - primary engine)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional Zaythar FastAPI backend integration:
ZAYTHAR_BACKEND_URL=http://localhost:8000

# Alternative AI Engines:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Firecrawl Web Search, Scraper & Crawler API:
FIRECRAWL_API_KEY=
FIRECRAWL_API_URL=https://api.firecrawl.dev/v1

# Firebase Firestore Cloud Sync for Agents:
FIREBASE_PROJECT_ID=zaythar-ai
FIREBASE_API_KEY=
FIREBASE_AUTH_TOKEN=

# Repo management (token ko sirf Contents + Pull requests ki ijazat dein):
GITHUB_TOKEN=
GITHUB_REPO=abdullakhan-tech/fluffy-umbrella

# Optional social accounts (leave blank to disable):
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
MASTODON_URL=
MASTODON_TOKEN=
X_USER_TOKEN=

# Boss khud har N minute health sweep kare (0 = band):
HEARTBEAT_MIN=0
# Roz ke jobs ki hadd (kharch par qaboo):
MAX_JOBS_PER_DAY=40
