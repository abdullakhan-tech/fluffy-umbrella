# Add at least one real provider key. Leave unused providers blank.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ZAYTHAR_AI_PROVIDER=hybrid

# Generate a random invitation secret (32+ characters) for account registration.
# Share it only with intended users; remove it from the server environment to disable new registrations.
ZAYTHAR_REGISTRATION_TOKEN=
# Bearer session lifetime: 12 hours by default (clamped to 5 minutes–30 days).
ZAYTHAR_SESSION_TTL_SECONDS=43200

# Per-process fallback limits; use a shared gateway limiter for multi-worker production.
ZAYTHAR_AUTH_RATE_LIMIT=8
ZAYTHAR_CHAT_RATE_LIMIT=20
