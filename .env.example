# Add at least one real provider key. Leave unused providers blank.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ZAYTHAR_AI_PROVIDER=hybrid
ZAYTHAR_CHAT_RATE_LIMIT=20

# Optional shared bearer token required for non-local API clients.
